// The Windows program's icon and the facts shown in its Properties window.
#include <winver.h>

IDI_ICON1 ICON "nachtzug.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Nachtzug"
      VALUE "FileDescription", "Nachtzug: music for night trains"
      VALUE "FileVersion", "0.1"
      VALUE "InternalName", "Nachtzug"
      VALUE "OriginalFilename", "Nachtzug.exe"
      VALUE "ProductName", "Nachtzug"
      VALUE "ProductVersion", "0.1"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
