# How Nachtzug's C++ is laid out (AGENTS.md, "Code style"). tools/format.sh checks it, tools/format.sh --write fixes it.
# Tabs for indentation, spaces only to line up a continued line; 120 characters a line; one statement per line,
# except that a short if (x) return; may stay on one line.
Language: Cpp
BasedOnStyle: LLVM
Standard: c++20
UseTab: ForIndentation
TabWidth: 4
IndentWidth: 4
ContinuationIndentWidth: 4
ColumnLimit: 120
AccessModifierOffset: -4
IndentCaseLabels: false
NamespaceIndentation: None
PointerAlignment: Left
ReferenceAlignment: Left
BreakBeforeBraces: Attach
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false
AllowShortFunctionsOnASingleLine: Inline
AllowShortLambdasOnASingleLine: All
AllowShortEnumsOnASingleLine: true
AlignTrailingComments:
  Kind: Always
  OverEmptyLines: 0
AlignAfterOpenBracket: Align
AlignOperands: Align
BinPackArguments: true
BinPackParameters: true
BreakConstructorInitializers: BeforeColon
PackConstructorInitializers: BinPack
Cpp11BracedListStyle: true
SpaceBeforeParens: ControlStatements
SortIncludes: Never
ReflowComments: true
KeepEmptyLines:
  AtStartOfBlock: false
MaxEmptyLinesToKeep: 1
FixNamespaceComments: true
InsertNewlineAtEOF: true
PenaltyReturnTypeOnItsOwnLine: 1000
